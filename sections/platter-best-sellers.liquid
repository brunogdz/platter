{{ 'platter-best-sellers.css' | asset_url | stylesheet_tag }}
<script src="{{ 'platter-best-sellers.js' | asset_url }}" defer="defer"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600&family=Source+Serif+4:wght@700;900&display=swap" rel="stylesheet">

{%- liquid
  assign use_demo = false
  if section.settings.products == blank and section.settings.demo_mode
    assign use_demo = true
  endif
  assign item_count = section.settings.products.size
  if use_demo
    assign item_count = 10
  endif
  assign show_more = false
  if item_count > 4
    assign show_more = true
  endif

  assign demo_primary = 'photo-1505740420928-5e560c06d30e|photo-1511499767150-a48a237f0083|photo-1542291026-7eec264c27ff|photo-1571771894821-ce9b6c11b08e|photo-1503376780353-7e6692767b70|photo-1590874103328-eac38a683ce7|photo-1602143407151-7111542de6e8|photo-1525966222134-fcfa99b8ae77|photo-1588850561407-ed78c282e89b|photo-1553062407-98eeb64c6a62' | split: '|'
  assign demo_secondary = 'photo-1484704849700-f032a568e944|photo-1517841905240-472988babdf9|photo-1495555961986-6d4c1ecb7be3|photo-1528825871115-3581a5387919|photo-1492144534655-ae79c964c9d7|photo-1548036328-c9fa89d128fa|photo-1523362628745-0c100150b504|photo-1520256862855-398228c41684|photo-1521369909029-2afed882baee|photo-1622560480654-d96214fdc887' | split: '|'
  assign demo_titles = 'Outside Vibes T-shirt Sunshine|Hike Bottle Outside Vibes Forest Green|Rest in Nature T-shirt Charcoal|Outside Vibes Cap Forest Green|Rest in Nature T-shirt Charcoal|Outside Vibes Canvas Tote|Hike Bottle Trail Edition|Outside Vibes Everyday Sneaker|Outside Vibes Sunshine Cap|Rest in Nature Trail Pack' | split: '|'
-%}

<platter-best-sellers class="platter-best-sellers" data-section-id="{{ section.id }}" data-show-more="{{ section.settings.show_more_label | escape }}" data-show-less="{{ section.settings.show_less_label | escape }}">
  <div class="platter-best-sellers__inner">
    <header class="platter-best-sellers__heading">
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.link_text != blank and section.settings.link_url != blank -%}
        <a class="platter-best-sellers__shop-all" href="{{ section.settings.link_url }}">
          {{ section.settings.link_text | escape }}
          <span aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </header>

    {%- if item_count > 0 -%}
      <div class="platter-best-sellers__viewport" data-viewport>
        <ul id="Products-{{ section.id }}" class="platter-best-sellers__list" data-list aria-label="{{ section.settings.heading | escape }}">
          {%- if use_demo -%}
            {%- for demo_image in demo_primary -%}
              {%- assign demo_index = forloop.index0 -%}
              <li class="platter-best-sellers__card" data-card>
                <div class="platter-best-sellers__image-wrap" tabindex="0" role="img" aria-label="{{ demo_titles[demo_index] | escape }} — alternate image on focus">
                  <img class="platter-best-sellers__image" src="https://images.unsplash.com/{{ demo_image }}?auto=format&amp;fit=crop&amp;w=800&amp;h=800&amp;q=85" alt="" width="355" height="355" loading="lazy">
                  <img class="platter-best-sellers__image platter-best-sellers__image--secondary" src="https://images.unsplash.com/{{ demo_secondary[demo_index] }}?auto=format&amp;fit=crop&amp;w=800&amp;h=800&amp;q=85" alt="" width="355" height="355" loading="lazy">
                  <span class="platter-best-sellers__badge">Best seller</span>
                  {%- if demo_index == 1 or demo_index == 3 or demo_index == 6 or demo_index == 9 -%}
                    <span class="platter-best-sellers__sale">Save {% if demo_index == 3 or demo_index == 9 %}15{% else %}10{% endif %}%</span>
                  {%- endif -%}
                </div>
                <div class="platter-best-sellers__details">
                  <span class="platter-best-sellers__name">{{ demo_titles[demo_index] }}</span>
                  <span class="platter-best-sellers__reviews"><span class="platter-best-sellers__stars" aria-label="4.5 out of 5 stars">★★★★<span class="platter-best-sellers__half-star">★</span></span><span>1,234 Reviews</span></span>
                  <span class="platter-best-sellers__price">$104.95</span>
                </div>
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for product in section.settings.products -%}
              <li class="platter-best-sellers__card" data-card>
                <a class="platter-best-sellers__product-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                  <span class="platter-best-sellers__image-wrap">
                    {%- if product.featured_image -%}
                      {{ product.featured_image | image_url: width: 800 | image_tag: class: 'platter-best-sellers__image', widths: '355, 533, 710, 800', sizes: '(max-width: 767px) calc((100vw - 60px) / 2), 355px', loading: 'lazy', alt: product.featured_image.alt | default: product.title }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'platter-best-sellers__image' }}
                    {%- endif -%}
                    {%- if product.images[1] != blank -%}
                      {{ product.images[1] | image_url: width: 800 | image_tag: class: 'platter-best-sellers__image platter-best-sellers__image--secondary', widths: '355, 533, 710, 800', sizes: '(max-width: 767px) calc((100vw - 60px) / 2), 355px', loading: 'lazy', alt: '' }}
                    {%- endif -%}
                    <span class="platter-best-sellers__badge">Best seller</span>
                    {%- if product.compare_at_price > product.price -%}
                      {%- assign savings_percent = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
                      <span class="platter-best-sellers__sale">Save {{ savings_percent }}%</span>
                    {%- endif -%}
                  </span>
                  <span class="platter-best-sellers__details">
                    <span class="platter-best-sellers__name">{{ product.title | escape }}</span>
                    {%- assign rating = product.metafields.reviews.rating.value -%}
                    {%- assign review_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count -%}
                    {%- if rating != blank and review_count != blank -%}
                      <span class="platter-best-sellers__reviews">
                        <span class="platter-best-sellers__stars" style="--rating: {{ rating.rating | times: 100.0 | divided_by: rating.scale_max }}%" aria-label="{{ rating.rating }} out of {{ rating.scale_max }} stars">★★★★★</span>
                        <span>{{ review_count }} Reviews</span>
                      </span>
                    {%- endif -%}
                    <span class="platter-best-sellers__price">{{ product.price | money }}</span>
                  </span>
                </a>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
      {%- if item_count > 1 -%}
        <div class="platter-best-sellers__carousel-controls" data-controls aria-label="Product carousel controls">
          <div class="platter-best-sellers__scroll-track" data-track>
            <div class="platter-best-sellers__scroll-thumb" data-thumb role="scrollbar" aria-label="Scroll best-selling products" aria-controls="Products-{{ section.id }}" aria-orientation="horizontal" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0"></div>
          </div>
        </div>
      {%- endif -%}
      {%- if show_more -%}
        <button class="platter-best-sellers__show-more" data-show-more-button type="button" aria-expanded="false" aria-controls="Products-{{ section.id }}">{{ section.settings.show_more_label | escape }}</button>
      {%- endif -%}
    {%- endif -%}
  </div>
</platter-best-sellers>

{% schema %}
{
  "name": "Platter Best Sellers",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Sellers" },
    { "type": "text", "id": "link_text", "label": "Shop all link text", "default": "Shop All Best Sellers" },
    { "type": "url", "id": "link_url", "label": "Shop all link" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 10 },
    { "type": "checkbox", "id": "demo_mode", "label": "Show design demo when no products are selected", "default": true },
    { "type": "text", "id": "show_more_label", "label": "Show more label", "default": "Show More" },
    { "type": "text", "id": "show_less_label", "label": "Show less label", "default": "Show Less" }
  ],
  "presets": [
    { "name": "Platter Best Sellers" }
  ]
}
{% endschema %}
